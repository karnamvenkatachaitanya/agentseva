# =========================================================================
# AgentSeva — Razorpay Agentic Commerce & Recovery Engine
# Environment template. Copy to `.env` and fill in real keys as needed:
#     cp .env.example .env
# Every value below has a working MOCK default, so the system runs end-to-end
# with NO real keys. Add real keys only to go "live".
# =========================================================================

# -------------------------------------------------------------------------
# Database  (SQLite for local/demo; PostgreSQL URL for production)
# -------------------------------------------------------------------------
DATABASE_URL=sqlite:///./app.db
SQLALCHEMY_ECHO=False

# -------------------------------------------------------------------------
# Authentication / signing
# SECRET_KEY: used to sign JWTs. MUST be a long random string in production.
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# -------------------------------------------------------------------------
SECRET_KEY=changeme_generate_a_long_random_secret

# -------------------------------------------------------------------------
# Claude (Anthropic) — powers the commerce agent (tool-use).
# REQUIRED for the live /agent/chat endpoint. Without it the agent returns 503
# and the manual test falls back to a scripted (offline) tool-calling demo.
#   Get a key: https://console.anthropic.com/settings/keys
# -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only needed for identity-linked (org) API keys — the workspace id (wrkspc_...).
# Leave blank when using a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_MAX_TOKENS=1024
AGENT_MAX_TURNS=8

# -------------------------------------------------------------------------
# Razorpay — payment gateway.
# RAZORPAY_MODE=mock  -> deterministic in-process simulator (no keys needed).
# RAZORPAY_MODE=live  -> real API; requires the test/live key pair below.
#   Get test keys: https://dashboard.razorpay.com/app/keys
# -------------------------------------------------------------------------
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# Enables HMAC-SHA256 verification of incoming webhooks (X-Razorpay-Signature).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=15

# -------------------------------------------------------------------------
# Payment guardrails (financial safety) — amounts in PAISE (1 INR = 100).
# -------------------------------------------------------------------------
MIN_TXN_AMOUNT_PAISE=100          # ₹1 floor
MAX_TXN_AMOUNT_PAISE=5000000      # ₹50,000 single-order cap
DAILY_CAP_PAISE=20000000          # ₹2,00,000 daily/session ceiling
ALLOWED_CURRENCIES=INR

# -------------------------------------------------------------------------
# Legacy Kiosk AI (Hugging Face) — OPTIONAL, only for the old kiosk chat.
# Leave blank to use the offline Kirana rule-engine fallback.
#   Get a token: https://huggingface.co/settings/tokens
# -------------------------------------------------------------------------
HUGGINGFACE_API_KEY=
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# -------------------------------------------------------------------------
# Frontend (dev only) — where the Vite dev proxy forwards /api calls.
# -------------------------------------------------------------------------
VITE_API_TARGET=http://localhost:8000
